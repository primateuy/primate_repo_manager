<odoo>

	<!-- En Odoo 19 los grupos ya no llevan `category_id`: cuelgan de un
	     `res.groups.privilege`, que es el que lleva la categoría. -->
	<record id="res_groups_privilege_repo_manager" model="res.groups.privilege">
		<field name="name">Repo Manager</field>
		<field name="sequence">45</field>
		<field name="category_id" ref="base.module_category_services"/>
	</record>

	<record id="group_repo_reader" model="res.groups">
		<field name="name">Lectura</field>
		<field name="sequence">10</field>
		<field name="privilege_id" ref="res_groups_privilege_repo_manager"/>
		<field name="comment">Ve el inventario de repos, las PRs y la auditoría.</field>
	</record>

	<record id="group_repo_lead" model="res.groups">
		<field name="name">Líder</field>
		<field name="sequence">20</field>
		<field name="privilege_id" ref="res_groups_privilege_repo_manager"/>
		<field name="comment">Además lanza auditorías y resuelve hallazgos.</field>
		<field name="implied_ids" eval="[Command.link(ref('group_repo_reader'))]"/>
	</record>

	<record id="group_repo_admin" model="res.groups">
		<field name="name">Administrador</field>
		<field name="sequence">30</field>
		<field name="privilege_id" ref="res_groups_privilege_repo_manager"/>
		<field name="comment">Además administra la conexión y las credenciales.</field>
		<field name="implied_ids" eval="[Command.link(ref('group_repo_lead'))]"/>
		<field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
	</record>

</odoo>
