<odoo>

	<!-- La página honesta de lo que todavía no existe. Ver `repo.coming.soon`. -->
	<record id="view_repo_coming_soon" model="ir.ui.view">
		<field name="name">repo.coming.soon.form</field>
		<field name="model">repo.coming.soon</field>
		<field name="arch" type="xml">
			<form string="Todavía no" create="false" edit="false">
				<sheet>
					<div class="rm-pendiente">
						<div class="rm-pendiente-etapa"><field name="stage" nolabel="1"
															   readonly="1"/></div>
						<h1><field name="name" nolabel="1" readonly="1"/></h1>
						<div class="rm-pendiente-que">
							<field name="description" nolabel="1" readonly="1"/>
						</div>
						<div class="rm-pendiente-pie">
							Esta sección ya tiene su lugar en el menú y no se va a mover
							cuando llegue: se habilita lo que hoy está en gris.
						</div>
					</div>
				</sheet>
			</form>
		</field>
	</record>

	<!-- ==================== D1.4 · Inventario de módulos ==================== -->

	<record id="view_repo_module_list" model="ir.ui.view">
		<field name="name">repo.module.list</field>
		<field name="model">repo.module</field>
		<field name="arch" type="xml">
			<list string="Módulos" create="false"
				  decoration-warning="divergent"
				  decoration-bf="repository_count &gt; 1">
				<field name="technical_name" class="rm-mono"/>
				<field name="display_name_manifest" optional="show"/>
				<field name="repository_count"/>
				<field name="copy_count" optional="show"/>
				<!-- La divergencia no se muestra sólo con color: lleva su texto. Es el
					 patrón del sistema de diseño y vale igual acá que en las severidades. -->
				<field name="divergent" widget="boolean_toggle" readonly="1"
					   string="Divergieron"/>
				<field name="divergence_detail" string="En qué línea" optional="show"/>
				<field name="backend_id" optional="hide"/>
			</list>
		</field>
	</record>

	<record id="view_repo_module_form" model="ir.ui.view">
		<field name="name">repo.module.form</field>
		<field name="model">repo.module</field>
		<field name="arch" type="xml">
			<form string="Módulo" create="false" edit="false">
				<sheet>
					<div class="oe_title">
						<h1 class="rm-mono"><field name="technical_name" readonly="1"/></h1>
						<div><field name="display_name_manifest" readonly="1"/></div>
					</div>
					<!-- Estar en más de un repositorio no es un problema: es el dato que
						 abre la conversación de promoción. Divergir sí cambia el trabajo. -->
					<div class="alert rm-alert-ok" role="alert"
						 invisible="divergent or repository_count &lt; 2">
						Este módulo vive en <field name="repository_count" nolabel="1"
												   readonly="1" class="oe_inline"/>
						repositorios y <b>todas las copias de cada línea son idénticas</b>.
						Promoverlo es mover algo que ya es una sola cosa.
					</div>
					<div class="alert rm-alert-warn" role="alert" invisible="not divergent">
						<b>Las copias divergieron</b> en
						<field name="divergence_detail" nolabel="1" readonly="1"
							   class="oe_inline"/>. Antes de promover hay que decidir
						<b>qué versión gana</b> y qué se hace con lo que se pierde: el
						módulo no lo resuelve solo, y elegir por antigüedad o por tamaño
						sería adivinar.
					</div>
					<group>
						<group>
							<field name="backend_id" readonly="1"/>
							<field name="repository_count" readonly="1"/>
						</group>
						<group>
							<field name="copy_count" readonly="1"/>
							<field name="divergent" readonly="1"/>
						</group>
					</group>
					<notebook>
						<page string="Dónde está" name="copias">
							<field name="copy_ids" readonly="1">
								<list string="Copias" create="false"
									  decoration-muted="not manifest_readable">
									<field name="repository_id"/>
									<field name="line" class="rm-mono"/>
									<field name="path" class="rm-mono" optional="show"/>
									<field name="version" class="rm-mono"/>
									<!-- El SHA del subárbol es LA evidencia: dos copias
										 con el mismo hash son idénticas byte a byte. Va
										 en mono, como todo lo que viene de git. -->
									<field name="tree_sha" class="rm-mono"
										   string="Hash del contenido"/>
									<field name="manifest_readable"
										   string="Manifiesto legible"/>
									<field name="manifest_error" optional="hide"/>
									<field name="last_seen_at" optional="hide"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_repo_module_search" model="ir.ui.view">
		<field name="name">repo.module.search</field>
		<field name="model">repo.module</field>
		<field name="arch" type="xml">
			<search string="Módulos">
				<field name="technical_name"/>
				<field name="display_name_manifest"/>
				<filter name="duplicados" string="En más de un repositorio"
						domain="[('repository_count', '&gt;', 1)]"/>
				<filter name="divergentes" string="Con copias divergentes"
						domain="[('divergent', '=', True)]"/>
				<group>
					<filter name="g_backend" string="Conexión" domain="[]"
							context="{'group_by': 'backend_id'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_repo_module" model="ir.actions.act_window">
		<field name="name">Inventario de módulos</field>
		<field name="res_model">repo.module</field>
		<field name="view_mode">list,form</field>
		<field name="search_view_id" ref="view_repo_module_search"/>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Todavía no se escaneó ningún módulo</p>
			<p>
				El inventario se arma leyendo el árbol de cada línea de versión. Abrí un
				repositorio y usá <b>Escanear módulos</b>, o esperá al escaneo programado.
			</p>
		</field>
	</record>

</odoo>
