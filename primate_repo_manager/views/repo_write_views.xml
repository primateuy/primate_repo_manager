<!--
	La pantalla del plan tiene un trabajo además de mostrar: que quien va a aprobar vea
	QUÉ está aprobando y que quien mira después vea si sigue siendo lo mismo. Por eso la
	huella está a la vista y no escondida en una pestaña técnica.
-->
<odoo>

	<record id="view_repo_write_plan_list" model="ir.ui.view">
		<field name="name">repo.write.plan.list</field>
		<field name="model">repo.write.plan</field>
		<field name="arch" type="xml">
			<list decoration-muted="state == 'rolled_back'"
				  decoration-danger="state == 'failed'"
				  decoration-success="state == 'applied'">
				<field name="name"/>
				<field name="backend_id"/>
				<field name="operation_count" string="Operaciones"/>
				<field name="approved_by_id"/>
				<field name="approved_at"/>
				<field name="is_frozen" string="Intacto"/>
				<field name="state" widget="badge"/>
			</list>
		</field>
	</record>

	<record id="view_repo_write_plan_form" model="ir.ui.view">
		<field name="name">repo.write.plan.form</field>
		<field name="model">repo.write.plan</field>
		<field name="arch" type="xml">
			<form>
				<header>
					<button name="action_add_operation" type="object"
							string="Agregar operación" class="btn-secondary"
							invisible="state != 'draft'"/>
					<button name="action_approve" type="object" string="Aprobar"
							class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_apply" type="object" string="Aplicar"
							class="btn-primary" invisible="state != 'approved'"
							confirm="Esto escribe sobre GitHub. ¿Aplicar el plan?"/>
					<button name="action_rollback" type="object" string="Revertir"
							invisible="state not in ('applied', 'failed')"
							confirm="Se restaura el estado previo guardado en la bitácora. ¿Revertir?"/>
					<button name="action_back_to_draft" type="object"
							string="Volver a borrador" invisible="state != 'approved'"/>
					<field name="state" widget="statusbar"
						   statusbar_visible="draft,approved,applied"/>
				</header>
				<sheet>
					<!-- Los contadores viajan invisibles: el componente los usa como
						 base mientras el bus todavía no habló. Mismo criterio que en la
						 corrida de auditoría. -->
					<field name="operation_count" invisible="1"/>
					<field name="applied_count" invisible="1"/>
					<field name="failed_count" invisible="1"/>
					<field name="started_at" invisible="1"/>
					<field name="finished_at" invisible="1"/>
					<field name="progress" widget="repo_live_progress" nolabel="1"
						   options="{'total': 'operation_count', 'done': 'applied_count',
									 'error': 'failed_count', 'inicio': 'started_at',
									 'fin': 'finished_at', 'cuenta': 'backend_id',
									 'modelo': 'repo.write.plan',
									 'corriendo': 'applying',
									 'terminado': 'applied,failed,rolled_back'}"/>
					<div class="oe_title">
						<h1><field name="name" placeholder="Referencia del plan"/></h1>
					</div>
					<group>
						<group>
							<field name="backend_id"/>
							<field name="operation_count"/>
						</group>
						<group>
							<field name="approved_by_id"/>
							<field name="approved_at"/>
						</group>
					</group>

					<!--
						El aviso de que el plan cambió después de aprobarse. Va acá arriba
						y no en una nota al pie: es la diferencia entre un plan que se va a
						ejecutar y uno que no.
					-->
					<div class="alert alert-warning" role="alert"
						 invisible="state != 'draft' or not approval_fingerprint">
						Este plan tenía una aprobación y la perdió porque cambió su
						contenido. Hay que volver a aprobarlo.
					</div>

					<notebook>
						<page string="Operaciones" name="operaciones">
							<field name="operation_ids">
								<list editable="bottom"
									  decoration-muted="state == 'rolled_back'"
									  decoration-danger="state == 'failed' or (is_destructive and state == 'pending')"
									  decoration-warning="state == 'blocked'"
									  decoration-success="state == 'applied'">
									<field name="sequence" widget="handle"/>
									<!-- La frase primero y el JSON después: es el orden
										 en que se lee un plan. El payload sigue estando
										 —es lo que se ejecuta— pero deja de ser lo único. -->
									<field name="description" readonly="1"/>
									<field name="is_destructive" string="Saca algo"
										   readonly="1"/>
									<field name="kind" optional="show"/>
									<field name="repository_id"/>
									<field name="target"/>
									<field name="payload_json" widget="text"
										   optional="hide"/>
									<field name="state" widget="badge" readonly="1"/>
									<field name="error" readonly="1" optional="show"/>
									<field name="audit_log_id" readonly="1"
										   optional="hide"/>
									<button name="action_rollback_operation"
											type="object" icon="fa-undo"
											title="Revertir sólo esta operación"
											invisible="state != 'applied'"
											confirm="Se restaura el estado previo de esta operación. ¿Revertir?"/>
								</list>
							</field>
						</page>
						<page string="Huella" name="huella">
							<group>
								<field name="is_frozen"/>
								<field name="approval_fingerprint"/>
								<field name="current_fingerprint"/>
							</group>
							<p class="text-muted">
								El apply compara estas dos huellas y no ejecuta si difieren,
								sin importar en qué estado figure el plan. Cubre lo que se
								va a ejecutar —conexión, operaciones, orden, destinos y
								payloads—; el nombre y las notas no entran.
							</p>
						</page>
						<page string="Notas" name="notas">
							<field name="note" placeholder="No entra en la huella."/>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_repo_audit_log_list" model="ir.ui.view">
		<field name="name">repo.audit.log.list</field>
		<field name="model">repo.audit.log</field>
		<field name="arch" type="xml">
			<!-- Sin `editable`: el modelo no acepta write, y una lista editable ofrecería
				 algo que siempre va a fallar. -->
			<list create="false" delete="false"
				  decoration-danger="event_type == 'write_failed'"
				  decoration-warning="event_type == 'write_blocked'">
				<field name="timestamp"/>
				<field name="event_type" widget="badge"/>
				<field name="summary"/>
				<field name="repository_name"/>
				<field name="member_login" optional="show"/>
				<field name="user_id"/>
			</list>
		</field>
	</record>

	<record id="view_repo_audit_log_form" model="ir.ui.view">
		<field name="name">repo.audit.log.form</field>
		<field name="model">repo.audit.log</field>
		<field name="arch" type="xml">
			<form create="false" edit="false" delete="false">
				<sheet>
					<div class="alert alert-info" role="alert">
						Las entradas de la bitácora no se modifican ni se borran. Si algo
						quedó mal registrado, la corrección es una entrada nueva.
					</div>
					<group>
						<group>
							<field name="timestamp"/>
							<field name="event_type"/>
							<field name="user_id"/>
						</group>
						<group>
							<field name="backend_id"/>
							<field name="repository_name"/>
							<field name="member_login"/>
						</group>
					</group>
					<field name="summary"/>
					<group string="Detalle">
						<field name="payload_json" nolabel="1" widget="text"/>
					</group>
					<group string="Estado previo (punto de retorno)">
						<field name="previous_state_json" nolabel="1" widget="text"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="action_repo_write_plan" model="ir.actions.act_window">
		<field name="name">Planes de escritura</field>
		<field name="res_model">repo.write.plan</field>
		<field name="view_mode">list,form</field>
	</record>

	<record id="action_repo_audit_log" model="ir.actions.act_window">
		<field name="name">Bitácora</field>
		<field name="res_model">repo.audit.log</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>
