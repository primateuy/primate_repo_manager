<odoo>

	<record id="view_repo_audit_run_list" model="ir.ui.view">
		<field name="name">repo.audit.run.list</field>
		<field name="model">repo.audit.run</field>
		<field name="arch" type="xml">
			<list string="Auditorías">
				<field name="name"/>
				<field name="backend_id"/>
				<field name="started_at"/>
				<field name="repos_total"/>
				<field name="repos_done"/>
				<field name="repos_error" decoration-danger="repos_error &gt; 0"/>
				<field name="progress" widget="progressbar"/>
				<field name="state" widget="badge"
					   decoration-success="state == 'done'"
					   decoration-warning="state in ('running', 'partial')"
					   decoration-danger="state == 'error'"/>
			</list>
		</field>
	</record>

	<record id="view_repo_audit_run_form" model="ir.ui.view">
		<field name="name">repo.audit.run.form</field>
		<field name="model">repo.audit.run</field>
		<field name="arch" type="xml">
			<form string="Auditoría">
				<header>
					<button name="action_start" type="object" string="Auditar"
							class="btn-primary" invisible="state != 'draft'"/>
					<button name="action_resume" type="object" string="Reanudar"
							class="btn-primary" invisible="state not in ('partial', 'error')"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_open_findings" type="object"
								class="oe_stat_button" icon="fa-exclamation-triangle"
								invisible="state in ('draft', 'running')">
							<field name="finding_count" widget="statinfo"
								   string="Hallazgos"/>
						</button>
					</div>
					<div class="oe_title"><h1><field name="name"/></h1></div>
					<!-- Los contadores se declaran invisibles a propósito: el componente los
					     necesita cargados para pintar el estado inicial, pero mostrarlos ADEMÁS
					     dejaría en pantalla dos versiones del mismo número: la del componente,
					     viva, y la del formulario, congelada en la carga. Una sola visible. -->
					<field name="repos_total" invisible="1"/>
					<field name="repos_done" invisible="1"/>
					<field name="repos_error" invisible="1"/>
					<field name="finding_count" invisible="1"/>
					<field name="critical_count" invisible="1"/>
					<field name="high_count" invisible="1"/>
					<field name="progress" widget="repo_live_progress" nolabel="1"/>
					<group>
						<group>
							<field name="backend_id"/>
							<field name="started_at"/>
						</group>
						<group>
							<field name="finished_at"/>
						</group>
					</group>
					<group string="Error" invisible="not error_detail">
						<field name="error_detail" nolabel="1" readonly="1"/>
					</group>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="action_repo_audit_run" model="ir.actions.act_window">
		<field name="name">Auditorías</field>
		<field name="res_model">repo.audit.run</field>
		<field name="view_mode">list,form</field>
	</record>

	<!-- ==================================================================
		 Hallazgos. Es lo que la auditoría produce: sin una lista con
		 columnas útiles, el resultado sólo existe dentro del PDF.
		 La pantalla completa —agrupada, con acciones de remediación— es A2;
		 esto es lo mínimo para poder leer el resultado desde la aplicación.
		 ================================================================== -->

	<record id="view_repo_audit_finding_list" model="ir.ui.view">
		<field name="name">repo.audit.finding.list</field>
		<field name="model">repo.audit.finding</field>
		<field name="arch" type="xml">
			<list string="Hallazgos" create="false"
				  decoration-danger="severity == 'critical'"
				  decoration-warning="severity == 'high'"
				  decoration-muted="severity == 'info'">
				<!-- El orden es el de lectura: qué tan grave, dónde, de qué se trata.
					 `optional` en las columnas anchas para que la fila entre sin scroll
					 horizontal con nombres reales —`primateuy/stock-logistics-…OCA` mide
					 lo que mide— y quien necesite más las prende. -->
				<field name="severity" widget="badge"
					   decoration-danger="severity == 'critical'"
					   decoration-warning="severity == 'high'"/>
				<field name="repository_id" optional="show"/>
				<field name="finding_type" optional="show"/>
				<field name="subject" optional="hide"/>
				<field name="summary"/>
				<field name="unreadable_cause" optional="hide"/>
				<field name="remediation_action" optional="hide"/>
				<field name="is_destructive" optional="hide"/>
				<field name="severity_modulated" optional="hide"/>
				<field name="run_id" optional="hide"/>
				<field name="severity_order" column_invisible="1"/>
				<field name="severity_rank" column_invisible="1"/>
				<field name="can_be_planned" column_invisible="1"/>
				<field name="planned_plan_id" optional="hide" string="Ya en el plan"/>
				<button name="action_remediate" type="object" icon="fa-wrench"
						title="Remediar esto: arma la operación en un plan. No escribe nada."
						groups="primate_repo_manager.group_repo_lead"
						invisible="not can_be_planned"/>
			</list>
		</field>
	</record>

	<record id="view_repo_audit_finding_form" model="ir.ui.view">
		<field name="name">repo.audit.finding.form</field>
		<field name="model">repo.audit.finding</field>
		<field name="arch" type="xml">
			<form string="Hallazgo" create="false" edit="false">
				<header>
					<button name="action_remediate" type="object"
							string="Remediar esto" class="btn-primary"
							groups="primate_repo_manager.group_repo_lead"
							invisible="not can_be_planned or planned_operation_id"/>
					<button name="action_remediate" type="object"
							string="Ver el plan donde ya está" class="btn-secondary"
							groups="primate_repo_manager.group_repo_lead"
							invisible="not planned_operation_id"/>
				</header>
				<sheet>
					<field name="can_be_planned" invisible="1"/>
					<field name="planned_operation_id" invisible="1"/>
					<!-- Ya planificado: se dice dónde, en vez de dejar que alguien lo
						 agregue de nuevo y se entere al aprobar. -->
					<div class="alert alert-info" role="alert"
						 invisible="not planned_operation_id">
						Ya está en el plan
						<field name="planned_plan_id" readonly="1" nolabel="1"
							   class="oe_inline"/>, pendiente de aplicar.
					</div>
					<!-- Y si no se puede planificar, por qué. Un botón ausente sin
						 explicación se lee como un olvido del producto. -->
					<div class="alert alert-secondary" role="alert"
						 invisible="can_be_planned or not why_not_planned">
						Este hallazgo no se remedia con un plan de escritura.
						<field name="why_not_planned" readonly="1" nolabel="1"/>
					</div>
					<div class="oe_title"><h1><field name="summary"/></h1></div>
					<group>
						<group>
							<field name="severity"/>
							<field name="severity_modulated"/>
							<field name="finding_type"/>
							<field name="subject"/>
						</group>
						<group>
							<field name="run_id"/>
							<field name="repository_id"/>
							<field name="unreadable_cause" invisible="not unreadable_cause"/>
						</group>
					</group>
					<group string="Detalle" invisible="not detail">
						<field name="detail" nolabel="1"/>
					</group>
					<group string="Remediación propuesta"
						   invisible="not remediation_action">
						<field name="remediation_action"/>
						<field name="is_destructive"/>
						<field name="remediation_payload"/>
					</group>
					<group string="Esperado contra observado"
						   invisible="not expected_json and not observed_json">
						<field name="expected_json"/>
						<field name="observed_json"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<record id="view_repo_audit_finding_search" model="ir.ui.view">
		<field name="name">repo.audit.finding.search</field>
		<field name="model">repo.audit.finding</field>
		<field name="arch" type="xml">
			<search string="Hallazgos">
				<field name="summary"/>
				<field name="repository_id"/>
				<field name="subject"/>
				<field name="run_id"/>
				<filter name="criticos" string="Críticos"
						domain="[('severity', '=', 'critical')]"/>
				<filter name="altos" string="Altos" domain="[('severity', '=', 'high')]"/>
				<separator/>
				<filter name="destructivas" string="Remediación destructiva"
						domain="[('is_destructive', '=', True)]"/>
				<filter name="no_legibles" string="No se pudieron leer"
						domain="[('unreadable_cause', '!=', False)]"/>
				<group>
					<filter name="g_sev" string="Severidad" domain="[]"
							context="{'group_by': 'severity_rank'}"/>
					<filter name="g_tipo" string="Tipo" domain="[]"
							context="{'group_by': 'finding_type'}"/>
					<filter name="g_repo" string="Repositorio" domain="[]"
							context="{'group_by': 'repository_id'}"/>
					<filter name="g_corrida" string="Corrida" domain="[]"
							context="{'group_by': 'run_id'}"/>
					<!-- Separa dos trabajos que hoy se ven iguales y no lo son: un techo
						 de plan se resuelve con una decisión de plata, una App sin
						 permisos se resuelve reinstalándola. -->
					<filter name="g_causa" string="Causa de ilegibilidad" domain="[]"
							context="{'group_by': 'unreadable_cause'}"/>
				</group>
			</search>
		</field>
	</record>

	<!-- Acción de lote: veinte ramas sin proteger son UN plan, no veinte. -->
	<record id="action_remediate_findings" model="ir.actions.server">
		<field name="name">Remediar: armar plan con estos</field>
		<field name="model_id" ref="model_repo_audit_finding"/>
		<field name="binding_model_id" ref="model_repo_audit_finding"/>
		<field name="binding_view_types">list</field>
		<field name="group_ids" eval="[Command.link(ref('group_repo_lead'))]"/>
		<field name="state">code</field>
		<field name="code">action = records.action_remediate_many()</field>
	</record>

	<record id="action_repo_audit_finding" model="ir.actions.act_window">
		<field name="name">Hallazgos</field>
		<field name="res_model">repo.audit.finding</field>
		<field name="view_mode">list,form</field>
		<field name="context">{'search_default_g_sev': 1}</field>
	</record>

	<record id="view_repo_repository_list" model="ir.ui.view">
		<field name="name">repo.repository.list</field>
		<field name="model">repo.repository</field>
		<field name="arch" type="xml">
			<!-- `multi_edit`: seleccionar varios y editar la clasificación de una sola
				 vez. Es el paso obligatorio de 43 repositorios reales; de a un formulario
				 por vez no es un flujo, es un castigo. El `write` del modelo marca cada
				 uno como «Definida a mano», así que el lote no abre ningún atajo: pasa
				 por la misma puerta que la edición de a uno. -->
			<list string="Repositorios" multi_edit="1" create="false">
				<field name="full_name" readonly="1"/>
				<field name="classification"/>
				<field name="classification_source" readonly="1"
					   decoration-bf="classification_source == 'manual'"/>
				<field name="finding_count" readonly="1" optional="show"/>
				<field name="visibility" readonly="1"/>
				<field name="default_branch" readonly="1" optional="hide"/>
				<field name="is_fork" readonly="1"/>
				<field name="governance_status" invisible="not is_fork"/>
				<field name="branch_count" readonly="1" optional="hide"/>
				<field name="collaborator_count" readonly="1" optional="hide"/>
				<field name="open_pr_count" readonly="1" optional="hide"/>
				<field name="sync_state" widget="badge" readonly="1"
					   decoration-success="sync_state == 'done'"
					   decoration-danger="sync_state == 'error'"/>
			</list>
		</field>
	</record>

	<record id="view_repo_repository_form" model="ir.ui.view">
		<field name="name">repo.repository.form</field>
		<field name="model">repo.repository</field>
		<field name="arch" type="xml">
			<form string="Repositorio" create="false">
				<sheet>
					<div class="oe_button_box" name="button_box">
						<button name="action_open_findings" type="object"
								class="oe_stat_button" icon="fa-exclamation-triangle">
							<field name="finding_count" widget="statinfo"
								   string="Hallazgos"/>
						</button>
					</div>
					<div class="oe_title">
						<h1><field name="full_name" readonly="1"/></h1>
						<div><field name="description" readonly="1"/></div>
					</div>
					<group>
						<group string="Qué es">
							<!-- Lo único editable a mano de toda la pantalla, y va
								 primero: es el paso obligatorio del flujo real. -->
							<field name="classification"/>
							<field name="classification_source" readonly="1"/>
							<field name="visibility" readonly="1"/>
							<field name="is_fork" readonly="1"/>
							<field name="upstream_full_name" readonly="1"
								   invisible="not is_fork"/>
						</group>
						<group string="Cómo está">
							<field name="default_branch" readonly="1"/>
							<field name="archived" readonly="1"/>
							<field name="pushed_at" readonly="1"/>
							<field name="backend_id" readonly="1"/>
							<field name="last_run_id" readonly="1"/>
						</group>
					</group>

					<!-- A3.4: la consecuencia dicha en pantalla y no escondida en un
						 tooltip que nadie abre. Marcar un fork como gobernado cambia un
						 hallazgo agregado por la evaluación completa: van a APARECER
						 hallazgos que hoy no se ven, y eso no es una regresión. -->
					<group string="Gobernanza del fork" invisible="not is_fork">
						<field name="governance_status"/>
						<div colspan="2" class="text-muted"
							 invisible="governance_status != 'pending_migration'">
							Mientras esté pendiente de migración, este fork produce
							<b>un solo hallazgo agregado</b>. Al marcarlo gobernado se lo
							evalúa contra el detalle completo de su plantilla y van a
							aparecer los hallazgos que hoy están resumidos en ese uno.
						</div>
					</group>

					<group string="Error de sincronización" invisible="not sync_error">
						<field name="sync_error" nolabel="1" readonly="1"/>
					</group>
					<group string="Lo que no se pudo leer" invisible="not unreadable_json">
						<div colspan="2" class="text-muted">
							No es «no cumple»: es «no se pudo mirar». Distinguirlo es lo
							que evita que el informe afirme de más.
						</div>
						<field name="unreadable_json" nolabel="1" readonly="1"/>
					</group>

					<notebook>
						<page string="Ramas" name="ramas">
							<field name="branch_ids" readonly="1">
								<list string="Ramas" create="false"
									  decoration-warning="not protection_readable">
									<field name="name"/>
									<field name="role"/>
									<field name="is_default"/>
									<field name="protected" widget="boolean_toggle"
										   readonly="1"/>
									<field name="protection_readable"
										   string="¿Se pudo leer?"/>
									<field name="protection_cause"
										   invisible="protection_readable"/>
									<field name="ruleset_count" optional="hide"/>
									<field name="last_commit_date" optional="hide"/>
								</list>
							</field>
						</page>
						<page string="Colaboradores" name="colaboradores">
							<field name="collaborator_ids" readonly="1">
								<list string="Colaboradores" create="false">
									<field name="member_id"/>
									<field name="permission"/>
									<!-- De dónde VIENE el permiso, y no sólo cuál es:
										 revertir un grant directo sobre alguien que además
										 está en un equipo no lo deja sin acceso, lo deja
										 con el del equipo. Sin esta columna, el plan de
										 escritura se arma a ciegas. -->
									<field name="source"/>
								</list>
							</field>
						</page>
						<page string="Hallazgos" name="hallazgos">
							<field name="finding_ids" readonly="1">
								<list string="Hallazgos" create="false"
									  decoration-danger="severity == 'critical'"
									  decoration-warning="severity == 'high'"
									  decoration-muted="severity == 'info'">
									<field name="severity" widget="badge"/>
									<field name="finding_type"/>
									<field name="subject"/>
									<field name="summary"/>
									<field name="run_id"/>
									<field name="severity_order" column_invisible="1"/>
								</list>
							</field>
						</page>
						<page string="Pull requests" name="prs">
							<field name="pull_request_ids" readonly="1">
								<list string="Pull requests" create="false">
									<field name="number"/>
									<field name="title"/>
									<field name="author_member_id"/>
									<field name="source_branch"/>
									<field name="target_branch"/>
									<field name="state" widget="badge"/>
									<field name="age_days"/>
									<field name="review_count"/>
								</list>
							</field>
						</page>
						<page string="Muestra de commits" name="commits">
							<field name="commit_sample_ids" readonly="1">
								<list string="Commits" create="false"
									  decoration-warning="not message_ok">
									<field name="branch_name"/>
									<field name="committed_at"/>
									<field name="author_login"/>
									<field name="message_first_line"/>
									<field name="message_ok" string="Convención"/>
									<field name="signed" string="Firmado"/>
								</list>
							</field>
						</page>
						<page string="Workflows" name="workflows">
							<field name="workflow_ids" readonly="1">
								<list string="Workflows de CI" create="false">
									<field name="name"/>
									<field name="path"/>
									<field name="state"/>
								</list>
							</field>
						</page>
					</notebook>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="view_repo_repository_search" model="ir.ui.view">
		<field name="name">repo.repository.search</field>
		<field name="model">repo.repository</field>
		<field name="arch" type="xml">
			<search string="Repositorios">
				<field name="full_name"/>
				<field name="classification"/>
				<field name="backend_id"/>
				<!-- El filtro con el que se enfrenta el trabajo real: los que ninguna
					 regla clasificó y alguien tiene que decidir a mano. -->
				<filter name="sin_clasificar" string="Sin clasificar"
						domain="[('classification', '=', False)]"/>
				<filter name="a_mano" string="Definidos a mano"
						domain="[('classification_source', '=', 'manual')]"/>
				<separator/>
				<filter name="forks" string="Forks" domain="[('is_fork', '=', True)]"/>
				<filter name="sin_gobernar" string="Forks sin migrar"
						domain="[('is_fork', '=', True),
								 ('governance_status', '=', 'pending_migration')]"/>
				<separator/>
				<filter name="con_error" string="Con error de sincronización"
						domain="[('sync_state', '=', 'error')]"/>
				<filter name="no_legible" string="Con algo que no se pudo leer"
						domain="[('unreadable_json', '!=', False)]"/>
				<separator/>
				<filter name="archivados" string="Archivados"
						domain="[('archived', '=', True)]"/>
				<group>
					<filter name="g_clas" string="Clasificación" domain="[]"
							context="{'group_by': 'classification'}"/>
					<filter name="g_origen" string="Origen de la clasificación" domain="[]"
							context="{'group_by': 'classification_source'}"/>
					<filter name="g_vis" string="Visibilidad" domain="[]"
							context="{'group_by': 'visibility'}"/>
					<filter name="g_conexion" string="Conexión" domain="[]"
							context="{'group_by': 'backend_id'}"/>
				</group>
			</search>
		</field>
	</record>

	<record id="action_repo_repository" model="ir.actions.act_window">
		<field name="name">Repositorios</field>
		<field name="res_model">repo.repository</field>
		<field name="view_mode">list,form</field>
		<field name="search_view_id" ref="view_repo_repository_search"/>
	</record>

</odoo>
