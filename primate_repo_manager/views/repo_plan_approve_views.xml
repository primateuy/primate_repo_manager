<odoo>

	<record id="view_repo_plan_approve_wizard" model="ir.ui.view">
		<field name="name">repo.plan.approve.wizard.form</field>
		<field name="model">repo.plan.approve.wizard</field>
		<field name="arch" type="xml">
			<form string="Aprobar plan">
				<div class="alert alert-info" role="alert">
					Esto es lo que el plan va a hacer, en palabras. <b>La aprobación
					congela exactamente estas frases</b>: si el plan cambia después, deja
					de estar aprobado y hay que volver a leerlo.
				</div>
				<div class="alert alert-warning" role="alert"
					 invisible="not destructive_count">
					Hay <field name="destructive_count" readonly="1" nolabel="1"
							   class="oe_inline"/> operación(es) que <b>sacan acceso o
					borran algo que otro puede estar usando</b>. Cada una lleva su propia
					confirmación: no hay un tilde que las apruebe a todas.
				</div>
				<div class="alert alert-danger" role="alert"
					 invisible="not irreversible_count">
					<b>Hay operaciones irreversibles.</b> No entran en el rollback: una vez
					aplicadas, deshacerlas no es apretar un botón. Para aprobar cada una
					hay que <b>escribir el nombre del objeto</b> que se va a tocar.
				</div>
				<field name="plan_id" invisible="1"/>
				<field name="pending_count" invisible="1"/>

				<!-- DOS BARRAS SEPARADAS, del prototipo. Mezclarlas diría «vas por el
					 80%» cuando lo que falta es justamente lo que no tiene vuelta atrás. -->
				<group class="rm-progreso">
					<label for="reversible_done" string="Reversibles aprobadas"
						   invisible="not reversible_count"/>
					<div invisible="not reversible_count">
						<field name="reversible_done" readonly="1" class="oe_inline rm-mono"/>
						/ <field name="reversible_count" readonly="1"
								 class="oe_inline rm-mono"/>
						<button name="action_approve_reversibles" type="object"
								string="Aprobar todas las reversibles"
								class="btn-link btn-sm"
								invisible="reversible_done >= reversible_count"/>
					</div>
					<label for="irreversible_done" string="Irreversibles confirmadas"
						   invisible="not irreversible_count"/>
					<div class="rm-irreversible" invisible="not irreversible_count">
						<field name="irreversible_done" readonly="1"
							   class="oe_inline rm-mono"/>
						/ <field name="irreversible_count" readonly="1"
								 class="oe_inline rm-mono"/>
					</div>
				</group>

				<field name="line_ids" nolabel="1">
					<list create="false" delete="false" editable="bottom"
						  decoration-danger="is_irreversible"
						  decoration-warning="is_destructive and not is_irreversible">
						<field name="sequence" column_invisible="1"/>
						<field name="is_destructive" string="Saca algo" readonly="1"/>
						<field name="is_irreversible" string="Sin vuelta atrás"
							   readonly="1"/>
						<field name="description" string="Qué va a pasar" readonly="1"/>
						<!-- Para lo irreversible no alcanza un tilde: hay que escribir el
							 nombre. Un tilde se marca sin leer —la mano va antes que el
							 ojo—; escribir el nombre obliga a mirar QUÉ se va a perder. -->
						<field name="target_name" column_invisible="1"/>
						<field name="typed_name" string="Escribí el nombre"
							   class="rm-mono rm-tipeo"
							   placeholder="nombre exacto"
							   readonly="not is_irreversible"
							   invisible="not is_irreversible"/>
						<field name="confirmed" string="Confirmo"
							   readonly="not is_destructive or is_irreversible"/>
						<field name="operation_id" column_invisible="1"/>
					</list>
				</field>
				<footer>
					<button name="action_confirm" type="object" string="Aprobar"
							class="btn-primary" invisible="pending_count"/>
					<button name="action_confirm" type="object"
							string="Aprobar (faltan confirmaciones)"
							class="btn-secondary" invisible="not pending_count"/>
					<button string="Cancelar" class="btn-secondary" special="cancel"/>
				</footer>
			</form>
		</field>
	</record>

</odoo>
