<odoo>

	<record id="view_repo_backend_list" model="ir.ui.view">
		<field name="name">repo.backend.list</field>
		<field name="model">repo.backend</field>
		<field name="arch" type="xml">
			<list string="Conexiones">
				<field name="name"/>
				<field name="owner_login"/>
				<field name="owner_type"/>
				<field name="last_sync"/>
				<field name="state" widget="badge"
					   decoration-success="state == 'connected'"
					   decoration-danger="state == 'error'"/>
			</list>
		</field>
	</record>

	<record id="view_repo_backend_form" model="ir.ui.view">
		<field name="name">repo.backend.form</field>
		<field name="model">repo.backend</field>
		<field name="arch" type="xml">
			<form string="Conexión">
				<header>
					<button name="action_test_connection" type="object" string="Probar conexión"
							class="btn-primary"/>
					<!-- Sólo aparece cuando hay algo que habilitar: con credenciales de
						 escritura cargadas y todavía sin habilitar. -->
					<button name="action_enable_writes" type="object"
							string="Habilitar escritura" class="btn-danger"
							groups="primate_repo_manager.group_repo_admin"
							invisible="write_enabled or not write_key_set"/>
					<button name="action_disable_writes" type="object"
							string="Deshabilitar escritura" class="btn-secondary"
							groups="primate_repo_manager.group_repo_admin"
							invisible="not write_enabled"/>
					<field name="state" widget="statusbar"/>
				</header>
				<sheet>
					<div class="oe_title">
						<h1><field name="name" placeholder="GitHub — PrimateUY"/></h1>
					</div>
					<group>
						<group string="Cuenta">
							<field name="provider"/>
							<field name="owner_login" placeholder="primateuy"/>
							<field name="owner_type"/>
									</group>
						<group string="Credenciales de la App">
							<field name="app_id" password="False"/>
							<field name="installation_id"
								   help="Está en la URL de la app instalada: /installations/&lt;número&gt;"/>
							<field name="private_key_set"/>
						</group>
						<group string="App de escritura (separada, sólo para aplicar cambios)">
							<!-- La habilitación es el acto deliberado que falta entre
								 «tener credenciales» y «poder escribir en producción».
								 Se muestra, no se edita: el modelo rechaza el write
								 directo justamente para que la entrada de bitácora no se
								 pueda saltear. -->
							<field name="write_enabled" readonly="1"/>
							<field name="write_enabled_by_id" readonly="1"
								   invisible="not write_enabled"/>
							<field name="write_enabled_at" readonly="1"
								   invisible="not write_enabled"/>
							<div colspan="2" class="text-muted"
								 invisible="write_enabled or environment != 'production'">
								Sobre una conexión de producción, tener las credenciales
								cargadas <b>no alcanza</b>: hasta que la escritura no se
								habilite desde el botón de arriba, cualquier intento de
								aplicar un plan se va a negar.
							</div>
							<field name="write_app_id"/>
							<field name="write_installation_id"/>
							<field name="write_private_key" password="True"
								   placeholder="Se guarda cifrada; no se vuelve a mostrar."/>
							<field name="write_key_set"/>
							<field name="private_key" password="True" widget="text"
								   placeholder="-----BEGIN RSA PRIVATE KEY----- …"
								   invisible="private_key_set"/>
							<div colspan="2" invisible="not private_key_set">
								<span class="text-muted">
									La private key está guardada y cifrada. No se muestra:
									para reemplazarla, vaciá el campo cifrado y cargá una nueva.
								</span>
							</div>
						</group>
					</group>
					<group string="Estado" invisible="state == 'draft'">
						<field name="last_sync"/>
						<field name="rate_remaining"/>
						<field name="last_error" invisible="state != 'error'"/>
					</group>
				</sheet>
				<chatter/>
			</form>
		</field>
	</record>

	<record id="action_repo_backend" model="ir.actions.act_window">
		<field name="name">Conexiones</field>
		<field name="res_model">repo.backend</field>
		<field name="view_mode">list,form</field>
	</record>

</odoo>
